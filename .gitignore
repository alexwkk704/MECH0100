# ---------------------------------------------------------------------------
# Outputs and working folders. Regenerated by the pipeline; never committed.
# ---------------------------------------------------------------------------
runs/
search/
validation/
pointclouds/
_backups/
_xfer/
_xfer2/
archive/
_to_delete/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Geometry and solver files. A solved .ntop is up to 448 MB and a single ADMS
# candidate STL is 200-225 MB; GitHub refuses anything over 100 MB.
# The one example STL is allowed back in on the last line.
# ---------------------------------------------------------------------------
*.ntop
*.stl
*.npz

# ---------------------------------------------------------------------------
# Backups of every flavour this project has produced.
# ---------------------------------------------------------------------------
*.bak
*.bak_*
*.backup_*
*.OLD_*

# ---------------------------------------------------------------------------
# LINEAR-ELEMENT DATA - superseded, and named here so it cannot be committed
# by accident later. Verified by reading the element_order column:
#   dataset_TPMS.csv      182 rows, element_order = linear
#   dataset_COMBINED.csv  182 linear TPMS rows + a stale 121-row ADMS set
# Only the _quad datasets are part of this work.
# ---------------------------------------------------------------------------
dataset_TPMS.csv
dataset_COMBINED.csv
tensors_TPMS.npz
tensors_COMBINED.npz
features_TPMS_TEST.csv
features_ADMS.OLD_std_columns.csv

# ---------------------------------------------------------------------------
# One-time setup scaffolding. These live on disk so they can be double-clicked,
# but they are nothing to do with the research pipeline and the push script has
# a personal repo URL in it, so they are not published.
# ---------------------------------------------------------------------------
GIT_2_INIT_COMMIT.bat
GIT_3_PUSH.bat

# ---------------------------------------------------------------------------
# Anything named _PRIVATE_* is a personal working note and is never published.
# Edit those files freely - git does not see them, so nothing enters the
# history and no rewrite is ever needed.
# ---------------------------------------------------------------------------
_PRIVATE_*

# ---------------------------------------------------------------------------
# The single example geometry, allowed back in.
# ---------------------------------------------------------------------------
!Inverse design/example/*.stl
